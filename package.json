{
  "name": "turbo-tumble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "server": "npm run start -w server",
    "build": "npm run build -w client",
    "start": "npm run build && npm run server",
    "lan": "node tools/lan.mjs",
    "typecheck": "tsc -p shared --noEmit && tsc -p client --noEmit && tsc -p server --noEmit",
    "check:arena": "tsx tools/check-arena.ts",
    "preview": "npm run preview -w client"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.4",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
